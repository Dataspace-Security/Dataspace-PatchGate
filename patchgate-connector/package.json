{
  "name": "patchgate-connector",
  "version": "1.0.0-rc3",
  "description": "PatchGate Connector: runs next to a bank site's Tactical RMM server, outbound-only HTTPS to PatchGate",
  "private": true,
  "type": "module",
  "bin": {
    "patchgate-connector": "dist/patchgate-connector.mjs"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "check:protocol": "node scripts/check-protocol-sync.mjs",
    "test": "node scripts/check-protocol-sync.mjs && vitest run",
    "test:watch": "vitest",
    "dev": "tsx src/cli.ts"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=24"
  }
}
