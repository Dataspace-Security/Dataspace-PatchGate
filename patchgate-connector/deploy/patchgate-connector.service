# systemd unit for the PatchGate Connector (bundle installed at /opt/patchgate-connector).
#   useradd --system --home /var/lib/patchgate-connector --shell /usr/sbin/nologin patchgate-connector
#   install -d -o patchgate-connector -g patchgate-connector -m 0700 /var/lib/patchgate-connector
#   install -m 0555 dist/patchgate-connector.mjs /opt/patchgate-connector/patchgate-connector.mjs
#   systemctl enable --now patchgate-connector
[Unit]
Description=PatchGate Connector (outbound-only bridge between PatchGate and the local Tactical RMM)
Documentation=file:///opt/patchgate-connector/README.md
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target

[Service]
Type=simple
User=patchgate-connector
Group=patchgate-connector
ExecStart=/usr/bin/node /opt/patchgate-connector/patchgate-connector.mjs run --config /etc/patchgate-connector/connector.json
Restart=always
RestartSec=5
KillSignal=SIGTERM
# must exceed limits.shutdownGraceSec
TimeoutStopSec=90
Environment=NODE_ENV=production

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/patchgate-connector
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
# If cache.port < 1024 (e.g. 443), use instead:
# CapabilityBoundingSet=CAP_NET_BIND_SERVICE
# AmbientCapabilities=CAP_NET_BIND_SERVICE
SystemCallArchitectures=native
UMask=0077
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
