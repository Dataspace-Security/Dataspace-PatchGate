# PatchGate production configuration — copy to deploy/.env.production (0600, never commit).
#
# Used twice: (1) `--env-file` for Compose variable substitution (images, sizes, hostname),
# (2) `env_file:` for every PatchGate container (application settings; validated by src/lib/env.ts —
# the container exits at start with "Invalid PatchGate configuration: <field>" if a value is wrong).
#
# RULES
# - Optional settings: leave the line COMMENTED OUT. An empty value (FOO=) is NOT "unset": zod rejects
#   "" for URLs and numbers and the app will not start.
# - Secrets are NOT set here. They are files in deploy/secrets/ (scripts/generate-secrets.sh), mounted at
#   /run/secrets/* and loaded by the image entrypoint (VAR_FILE -> VAR). Setting both VAR and VAR_FILE
#   aborts the container ("entrypoint.secret_conflict.VAR").
# - Values are plain KEY=value (no quotes, no spaces around "=").

############################################################################ Compose / platform
# Images (build: docker build -t <img>:<ver> --build-arg PATCHGATE_BUILD_ID=<ver> patchgate-web;
#                docker build -t <tools-img>:<ver> --target tools patchgate-web). Always use the SAME version.
PATCHGATE_IMAGE=registry.example.com/patchgate-web:1.0.0
PATCHGATE_TOOLS_IMAGE=registry.example.com/patchgate-tools:1.0.0
# NGINX_IMAGE=nginx:1.28-alpine
# POSTGRES_IMAGE=postgres:16-bookworm     # DB server: keep the OS (glibc collations) stable for an existing data dir
# BACKUP_BASE_IMAGE=debian:trixie-slim     # backup tools: PGDG postgresql-client-16 + age (built from source)
# EGRESS_PROXY_IMAGE=patchgate-egress-proxy:local
# BACKUP_IMAGE=patchgate-backup:local
# SCHEDULER_IMAGE=curlimages/curl:8.11.1

# Public DNS name (nginx server_name; certificate in deploy/tls/fullchain.pem + privkey.pem).
PATCHGATE_HOSTNAME=patchgate.example.com
# HTTPS_BIND=0.0.0.0
# HTTP_BIND=0.0.0.0
# HTTPS_PORT=443
# HTTP_PORT=80

# Database names / roles (created on first start by postgres/initdb/10-patchgate-roles.sh).
POSTGRES_DB=patchgate
DB_OWNER_USER=patchgate_owner
DB_APP_USER=patchgate_app
# Prisma pool per container (3 app containers x 10 = 30 connections + backup + replica). If you override this,
# KEEP the TLS part: the DB accepts only TLS on the network, and Prisma verifies the server certificate
# (chain against the internal DB CA secret pg_ca_cert + hostname "db") only with sslaccept=strict + sslcert.
# Prisma 6 accepts sslmode=verify-full silently WITHOUT verifying — never rely on it.
# DB_URL_PARAMS=connection_limit=10&pool_timeout=20&sslmode=require&sslaccept=strict&sslcert=/run/secrets/pg_ca_cert

# PostgreSQL tuning (defaults sized for a 16 GB host; see RUNBOOK §1 sizing table).
# PG_SHARED_BUFFERS=1GB
# PG_EFFECTIVE_CACHE_SIZE=3GB
# PG_WORK_MEM=16MB
# PG_MAINTENANCE_WORK_MEM=256MB
# PG_MAX_CONNECTIONS=200

# Container limits.
# WEB_CPUS=2
# WEB_MEMORY=2g
# FETCHER_CPUS=2
# FETCHER_MEMORY=3g
# DB_CPUS=4
# DB_MEMORY=6g

# Networks (fixed so the host firewall can match them; RUNBOOK §4.3). Must not overlap existing host /
# Docker networks ("Pool overlaps with other one on this address space" at `up`).
# SIEM_OUT_SUBNET=172.30.10.0/24
# FETCH_EGRESS_SUBNET=172.30.20.0/24      # EGRESS_PROXY_IP must be inside it
# EGRESS_PROXY_IP=172.30.20.10
# DB_ADMIN_SUBNET=172.30.30.0/24          # backup <-> db; the ONLY source allowed to log in as postgres

# Job signer (deploy/signer; per-bank keys in secrets/job-signing-keys/). Web containers use it via
# JOB_SIGNER=remote (fixed in compose); the fetcher and migrate run with JOB_SIGNER=disabled.
# SIGNER_IMAGE=patchgate-signer:local
# SIGNER_RATE_PER_TENANT_PER_MIN=600      # signatures per bank per minute
# SIGNER_RATE_PER_MIN=3000                # all banks
# SIGNER_MAX_SCHEDULE_DAYS=90             # max notBefore ahead of now
# SIGNER_REQUIRE_TENANT_KEY=false         # true = refuse banks without their own key (no default-key fallback)

# Backups: age PUBLIC key(s), comma-separated. The private key stays offline (RUNBOOK §7).
BACKUP_AGE_RECIPIENTS=age1replace0with0your0public0key000000000000000000000000000000
# BACKUP_DIR=./backups                   # host path; mount NFS/off-host storage here
# BACKUP_HOUR_UTC=1
# BACKUP_RETENTION_DAYS=35
# BACKUP_REPO=weekly                     # weekly | always | never (package store snapshot)
# BACKUP_REPO_RETENTION_WEEKS=4
# Replica (profile "replica").
# REPLICA_SLOT=patchgate_replica_1

############################################################################ Application (src/lib/env.ts)
# Logging (src/lib/log.ts): debug | info | warn | error | silent
LOG_LEVEL=info

# NODE_ENV — fixed to "production" by docker-compose.prod.yml. Anything else disables production checks.

# DATABASE_URL — DO NOT SET. Built by the entrypoint from DB_HOST/DB_PORT/DB_NAME/DB_USER + secret
# db_app_password (postgresql://patchgate_app:***@db:5432/patchgate?schema=public&<DB_URL_PARAMS>).

# Tactical RMM API. Required by env.ts. In the hosted model the bank's CONNECTOR talks to Tactical; this
# is only used by legacy direct mode. Must be https in production.
TACTICAL_API_URL=https://tactical.invalid
# TACTICAL_API_KEY — secret file tactical_api_key (>= 20 chars; generated placeholder in hosted mode).
# TACTICAL_TIMEOUT_MS=15000
# ID of the signed PatchGate install script registered in Tactical (positive integer; legacy direct mode).
# TACTICAL_INSTALL_SCRIPT_ID=12

# Legacy direct mode only: URL offline PCs download packages from (/repo). https only. In the hosted
# deployment /repo is NOT served (nginx returns 404, allowlists/repo.conf; REPO_PUBLIC=false below):
# connectors download through the signed /api/connector/v1/packages endpoint.
PATCH_REPO_URL=https://patchgate.example.com/repo
# Serve /repo publicly from the app? Hosted deployment: false (connectors use the signed packages endpoint).
REPO_PUBLIC=false

# AUDIT_HMAC_KEY — secret file audit_hmac_key (>= 32 chars). Keys the audit hash chain. NEVER lose it.
# WORKER_TOKEN   — secret file worker_token (>= 32 chars). Scheduler -> /api/worker/tick|fetch.
# WSUS_TOKEN     — secret file wsus_token (>= 32 chars, optional in env.ts). WSUS connector scripts.

# Platform SIEM for the audit trail — MANDATORY in production, tls:// only.
SIEM_SYSLOG_URL=tls://siem.example.internal:6514
# PEM of the CA that signed the SIEM certificate (mount it in deploy/ca/).
SIEM_CA_FILE=/etc/patchgate/ca/siem-ca.pem
# Hostname reported in syslog records (defaults to the container hostname web-1/web-2/fetcher).
# SIEM_HOSTNAME=patchgate-prod

# Package store — fixed to the shared volume by docker-compose.prod.yml (REPO_DIR=/data/repo).
# REPO_DIR=/data/repo
# Hours a newly fetched third-party package waits before it can be approved (0-720).
QUARANTINE_HOURS=48
# Per-download timeout and size cap.
# FETCH_TIMEOUT_MS=600000
# FETCH_MAX_BYTES=2147483648
# Optional read-only GitHub token (no scopes) to raise API rate limits. Prefer a secret: see RUNBOOK §4.2.
# GITHUB_TOKEN=
# CA bundle for Authenticode verification with osslsigncode (Linux). MUST contain the code-signing roots
# (incl. Microsoft Root Certificate Authority 2010/2011 — not in the Mozilla TLS bundle). RUNBOOK §4.4.
# Also used for the timestamp chain. The winget catalogue index needs BOTH Microsoft roots 2011 + 2010.
CODESIGN_CA_FILE=/etc/patchgate/ca/codesign-ca.pem
# Online CRL revocation check (plain HTTP to the CRL hosts): "off" (default; the egress proxy allows
# HTTPS CONNECT only) or "online" (only after allowing HTTP to the CRL hosts). RUNBOOK §4.4.
# CODESIGN_CRL_CHECK=off

# Trusted reverse proxies in front of the app. nginx = 1 (fixed in compose). Production requires >= 1.
# TRUST_PROXY_HOPS=1

# ---- Login mode: "local" (PatchGate accounts: password + mandatory TOTP) is the production default.
#      "oidc" = external IdP (all OIDC_* below required). "dev" is rejected in production.
AUTH_MODE=local
# AUTH_ENC_KEY — secret file auth_enc_key (64 hex). Encrypts TOTP secrets at rest. Required for local.
SESSION_IDLE_MINUTES=15
SESSION_MAX_HOURS=8

# ---- Optional OIDC (only with AUTH_MODE=oidc; all-or-nothing). Must be https.
# OIDC_ISSUER_URL=https://login.microsoftonline.com/<tenant>/v2.0
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=                    # prefer a secret file: OIDC_CLIENT_SECRET_FILE=/run/secrets/oidc_client_secret
# OIDC_REDIRECT_URI=https://patchgate.example.com/api/auth/callback
# OIDC_POST_LOGOUT_REDIRECT_URI=https://patchgate.example.com/login
# OIDC_SCOPES=openid profile email
# OIDC_ROLE_CLAIM=roles
# OIDC_ROLE_MAP=PatchGate.Admin=ADMIN; PatchGate.Approver=APPROVER; PatchGate.Operator=OPERATOR; PatchGate.Viewer=VIEWER
# OIDC_UPN_CLAIM=preferred_username
# Which users this IdP signs in: "platform" (our team) or ONE bank Tenant.id. Required for oidc mode.
# An IdP can never create platform staff unless set to platform.
# OIDC_USER_SCOPE=platform

# DEV_USER_UPN — development only; never set in production.

# ---- Connector link
# Job signing — fixed per container by docker-compose.prod.yml, do NOT set here:
#   web-1/2: JOB_SIGNER=remote, JOB_SIGNER_URL=http://signer:8080, JOB_SIGNER_TOKEN_FILE=/run/secrets/job_signer_token
#   fetcher, migrate: JOB_SIGNER=disabled (never sign)
#   JOB_SIGNER=file + JOB_SIGNING_KEY_FILE (key inside the web process) is for lab/dev only.
# Public URL connectors use (shown at enrolment). Also baked into /install/site.sh (one-line site install).
PUBLIC_BASE_URL=https://patchgate.example.com

# ---- One-line site install (GET /install/site.sh + /install/bundle/<version>/<file>, RUNBOOK §6.1)
# PATCHGATE_SITE_BUNDLE_DIR — fixed by docker-compose.prod.yml (/data/site-bundles = read-only volume
#   "site-bundles" in web-1/web-2), do NOT set here. Unset = the /install endpoints answer 404.
# Version served as "latest" and as /install/site.sh. Leave commented out to use the LATEST file in the
# volume (switching versions then needs no restart). [A-Za-z0-9._-], max 40.
# PATCHGATE_SITE_BUNDLE_LATEST=2026.10.1
# REQUIRED for the one-line install: the bundle-signing public key (bundle-signing.pub.txt written by
# build-site-bundle.sh --sign-key). Baked into /install/site.sh; a downloaded bundle without a valid signature
# from it is refused, so a tampered site-bundles volume cannot reach a bank. Keep the PRIVATE key offline.
# PATCHGATE_SITE_BUNDLE_PUBKEY=ed25519:<base64 of 32 bytes>

# ---- Monitoring
# METRICS_TOKEN — secret file metrics_token (>= 32 chars; generate-secrets.sh), loaded via METRICS_TOKEN_FILE
#   on web-1/web-2 (fixed in compose) and used by the bundled Prometheus as its bearer credentials_file.
#   Do NOT set METRICS_TOKEN here (VAR + VAR_FILE aborts the container). Unset secret = /api/metrics is 404.

# ---- Notifications (optional; unset = notifications are recorded in the outbox and marked SKIPPED)
# Outgoing mail. smtps://user:pass@host:465 (implicit TLS) or smtp://user:pass@host:587 (STARTTLS, required
# in production). The URL holds the SMTP password: prefer a secret file — add secrets/smtp_url, a `secrets:`
# entry and SMTP_URL_FILE=/run/secrets/smtp_url for web-1/web-2 (the image entrypoint loads *_FILE).
# SMTP_URL=smtp://patchgate:CHANGE_ME@smtp-relay.example.internal:587
# Sender address (3-320 chars).
# SMTP_FROM=PatchGate <patchgate@example.com>
# Webhook hosts (Teams / Slack incoming webhooks) bank and platform admins may add, exact host names,
# comma-separated. Unset = webhooks disabled. Webhook URLs are stored ENCRYPTED with AUTH_ENC_KEY.
# NOTIFY_WEBHOOK_ALLOWED_HOSTS=hooks.slack.com,example.webhook.office.com

# ---- Node.js
# Extra CAs trusted for outbound TLS (SIEM, internal services). PEM bundle in deploy/ca/.
NODE_EXTRA_CA_CERTS=/etc/patchgate/ca/internal-ca.pem
# Heap cap per container (keep below the container memory limit).
NODE_OPTIONS=--max-old-space-size=1536
