# Copy to .env and fill in. Never commit real values.

# PostgreSQL (PatchGate's own DB)
# Dev: `docker compose -f docker-compose.dev.yml up -d`
DATABASE_URL=postgresql://patchgate:patchgate-dev-only@127.0.0.1:55432/patchgate?schema=public
# Integration tests only (must contain "patchgate_test"): npm run test:int
TEST_DATABASE_URL=postgresql://patchgate:patchgate-dev-only@127.0.0.1:55432/patchgate_test?schema=public

# Tactical RMM — internal/offline server. PatchGate is the ONLY component with internet.
TACTICAL_API_URL=https://tactical.bank.local
# Dedicated API key for a least-privilege Tactical user (win-update + software + run-script perms)
TACTICAL_API_KEY=replace-with-tactical-api-key-min-20-chars
TACTICAL_TIMEOUT_MS=15000
# ID of the signed PatchGate install script registered in Tactical (third-party deploys)
TACTICAL_INSTALL_SCRIPT_ID=

# Internal package repo served by PatchGate that offline PCs download from
PATCH_REPO_URL=https://patchgate.bank.local/repo

# Audit chain HMAC key (>=32 chars). Store in a secret manager, NOT on the DB host.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUDIT_HMAC_KEY=

# Token the local scheduler sends to /api/worker/tick and /api/worker/fetch (>=32 chars)
WORKER_TOKEN=
# Token for the WSUS connector scripts (scripts/wsus/*.ps1), >=32 chars
WSUS_TOKEN=

# Bank SIEM for the audit trail — MANDATORY in production (tls:// only outside dev)
SIEM_SYSLOG_URL=tls://siem.bank.local:6514
# PEM of the bank CA that signed the SIEM certificate
SIEM_CA_FILE=
# Hostname reported in syslog records (defaults to OS hostname)
SIEM_HOSTNAME=

# Internal package repository (served read-only at /repo to the offline zone)
REPO_DIR=./repo-data
# Hours a newly fetched third-party package waits before it can be approved
QUARANTINE_HOURS=48
FETCH_TIMEOUT_MS=600000
FETCH_MAX_BYTES=2147483648
# Optional: GitHub token (read-only, no scopes) to raise API rate limits for winget/Tactical lookups
GITHUB_TOKEN=
# Non-Windows PatchGate hosts only: CA bundle for osslsigncode Authenticode verification
CODESIGN_CA_FILE=

# DEV ONLY — identity until SSO is wired. Honoured only when NODE_ENV=development.
DEV_USER_UPN=operator@dev.local

# Number of trusted reverse proxies in front of PatchGate (bank nginx/F5 = 1). 0 = ignore X-Forwarded-For.
TRUST_PROXY_HOPS=0
