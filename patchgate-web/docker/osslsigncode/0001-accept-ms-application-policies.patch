 /*
  * X509_STORE_CTX_verify_cb
  */
+/*
+ * PatchGate: Microsoft "Application Policies" (szOID_APPLICATION_CERT_POLICIES, 1.3.6.1.4.1.311.21.10)
+ * is marked critical in current Microsoft Store/Marketplace signing certificates (e.g. the winget
+ * source.msix signer). OpenSSL does not implement it and rejects the chain with
+ * X509_V_ERR_UNHANDLED_CRITICAL_EXTENSION. Accept that error ONLY when every critical extension
+ * OpenSSL does not support is this one OID; any other unknown critical extension still fails.
+ * The extension narrows usage like EKU does; the signer EKU (codeSigning) is still enforced.
+ * [in] cert: X509 certificate
+ * [returns] 1 if the only unsupported critical extensions are allow-listed, else 0
+ */
+static int ms_known_critical_only(X509 *cert)
+{
+    int i, found = 0;
+    ASN1_OBJECT *allowed = OBJ_txt2obj("1.3.6.1.4.1.311.21.10", 1);
+
+    if (!cert || !allowed) {
+        ASN1_OBJECT_free(allowed);
+        return 0; /* FAILED */
+    }
+    for (i = 0; i < X509_get_ext_count(cert); i++) {
+        X509_EXTENSION *ext = X509_get_ext(cert, i);
+
+        if (!X509_EXTENSION_get_critical(ext) || X509_supported_extension(ext))
+            continue;
+        if (OBJ_cmp(X509_EXTENSION_get_object(ext), allowed) != 0) {
+            ASN1_OBJECT_free(allowed);
+            return 0; /* unknown critical extension that is not allow-listed */
+        }
+        found = 1;
+    }
+    ASN1_OBJECT_free(allowed);
+    return found;
+}
+
 static int verify_ca_callback(int ok, X509_STORE_CTX *ctx)
 {
     int error = X509_STORE_CTX_get_error(ctx);
@@ -1903,6 +1937,9 @@
