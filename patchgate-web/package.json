{
  "name": "patchgate-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "cross-env NODE_ENV=development tsx --env-file=.env prisma/seed.ts",
    "db:studio": "prisma studio",
    "test:int": "cross-env INTEGRATION=1 vitest run src/test",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "cron-parser": "^5.10.2",
    "lucide-react": "^1.57.0",
    "next": "16.4.0",
    "nodemailer": "^10.1.1",
    "openid-client": "^6.8.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "yaml": "^2.9.1",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/yauzl": "^3.4.0",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=22"
  }
}
